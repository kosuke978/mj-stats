      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/leagues/{{league_id}}/invites/{{invite_id}}/revoke",
        "description": "owner/admin向け。失効と同じ操作IDの再送は200。versionは文字列。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_request_id\": \"{{client_request_id}}\",\n  \"version\": \"{{invite_version}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
