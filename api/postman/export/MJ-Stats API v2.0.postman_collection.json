          "mode": "raw",
          "raw": "{\n  \"client_request_id\": \"{{client_request_id}}\",\n  \"version\": \"{{object_version}}\",\n  \"reason\": \"隔離環境で変更内容を確認\",\n  \"rule_id\": \"{{rule_id}}\",\n  \"season_id\": null,\n  \"match_date\": \"2024-11-01T09:00:00+09:00\",\n  \"players\": [\n    {\n      \"user_id\": \"{{player_1_id}}\",\n      \"raw_score\": 35000\n    },\n    {\n      \"user_id\": \"{{player_2_id}}\",\n      \"raw_score\": 35000\n    },\n    {\n      \"user_id\": \"{{player_3_id}}\",\n      \"raw_score\": 20000\n    },\n    {\n      \"user_id\": \"{{player_4_id}}\",\n      \"raw_score\": 10000\n    }\n  ]\n}",
