{
  "info": {
    "name": "MJ-Stats API v2.0",
    "description": "Step 3のリーグ別ゲスト・計算・保存・詳細と、認証・所属・招待・履歴。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/health",
        "auth": {
          "type": "noauth"
        }
      },
      "response": []
    },
    {
      "name": "1. Calculate Match Points (410)",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/api/matches/calculate",
        "description": "名前設定済みは410 API_RETIRED。未認証は401。計算・保存の副作用なし。"
      },
      "response": []
    },
    {
      "name": "2. Create Match (410)",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/api/matches",
        "description": "名前設定済みは410 API_RETIRED。未認証は401。計算・保存の副作用なし。"
      },
      "response": []
    },
    {
      "name": "3. Get Matches",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/leagues/{{league_id}}/matches?season=all&limit=20",
        "description": "所属リーグの通常対局だけ。season: all/unassigned/UUID、status: all/valid/cancelled、limit: 1〜100、cursor: 同じ条件のnext_cursor。 pointは分子と分母が整数文字列の既約分数。"
      },
      "response": []
    },
    {
      "name": "4. Get Me",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/users/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"me is authenticated\", () => pm.response.to.have.status(200));",
              "pm.test(\"persistent participant + profile state\", () => { const u=pm.response.json(); pm.expect(u.id).to.be.a(\"string\"); pm.expect(u).to.have.property(\"profile_completed_at\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Set My Display Name",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/api/users/me",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Postman Player\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "6. Missing Bearer (401)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/users/me",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"unauthenticated\", () => pm.response.to.have.status(401));",
              "pm.test(\"common error\", () => pm.expect(pm.response.json().error.code).to.eql(\"UNAUTHENTICATED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Invalid JWT (401)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/users/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "invalid.jwt.fixture",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"invalid JWT rejected\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. My Leagues",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/leagues",
        "description": "本人の有効所属一覧。"
      },
      "response": []
    },
    {
      "name": "9. League",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/leagues/{{league_id}}",
        "description": "対象リーグと本人のrole。非所属または存在しないUUIDは403。"
      },
      "response": []
    },
    {
      "name": "10. Participants",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/leagues/{{league_id}}/participants?limit=20",
        "description": "有効な参加者。limit・cursor可。"
      },
      "response": []
    },
    {
      "name": "11. Members",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/leagues/{{league_id}}/members?limit=20",
        "description": "legacyを除く所属。limit・cursor可。"
      },
      "response": []
    },
    {
      "name": "12. Rules",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/leagues/{{league_id}}/rules?available=true&limit=20",
        "description": "available=true（既定）/false/all。limit・cursor可。"
      },
      "response": []
    },
    {
      "name": "13. Seasons",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/leagues/{{league_id}}/seasons?limit=20",
        "description": "UUID、開始・終了日はYYYY-MM-DDかNULL。limit・cursor可。"
      },
      "response": []
    },
    {
      "name": "14. History Without League (400)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/matches",
        "description": "旧全件経路の拒否。名前設定済みは400 INVALID_INPUT。"
      },
      "response": []
    },
    {
      "name": "15. Scoped History Adapter",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/matches?league_id={{league_id}}&season=all&limit=20",
        "description": "所属リーグの通常対局だけ。season: all/unassigned/UUID、status: all/valid/cancelled、limit: 1〜100、cursor: 同じ条件のnext_cursor。 pointは分子と分母が整数文字列の既約分数。"
      },
      "response": []
    },
    {
      "name": "16. Create League",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/leagues",
        "description": "名前設定済み登録者が初期ownerとして作成。初回201、同じ操作IDと内容の再送は200、内容違いは409。新規操作ごとにUUIDを変え、再送では同じUUIDを保持する。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postmanリーグ\",\n  \"client_request_id\": \"{{client_request_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "17. Current Invite",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/leagues/{{league_id}}/invites/current",
        "description": "owner/admin向け。200。未発行・期限切れ・失効時はinviteがnull。"
      },
      "response": []
    },
    {
      "name": "18. Issue Invite",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/leagues/{{league_id}}/invites",
        "description": "owner/admin向け。初回201、同じ操作IDでの再送は200。発行すると以前の未失効招待は失効。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_request_id\": \"{{client_request_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "19. Revoke Invite",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/leagues/{{league_id}}/invites/{{invite_id}}/revoke",
        "description": "owner/admin向け。失効と同じ操作IDの再送は200。versionは文字列。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_request_id\": \"{{client_request_id}}\",\n  \"version\": \"{{invite_version}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "20. Search Leagues",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/leagues/search?q={{search_q}}&limit=20",
        "description": "掲載リーグだけを最小情報で返す。"
      },
      "response": []
    },
    {
      "name": "21. Resolve League Number",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/leagues/resolve",
        "description": "番号で最小リーグ情報を取得。非掲載も可。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"group_number\": \"{{group_number}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "22. Preview Join",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/leagues/join-preview",
        "description": "招待確認だけを行い、所属は変更しない。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"group_number\": \"{{group_number}}\",\n  \"code\": \"{{invite_code}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "23. Join League",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/leagues/{{league_id}}/join",
        "description": "明示した参加操作。再送は同じ操作IDを使う。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"{{invite_code}}\",\n  \"client_request_id\": \"{{client_request_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "24. Create Guest",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/leagues/{{league_id}}/guests",
        "description": "ゲストと所属を一括作成。同名でも別操作なら別ID。201、同じIDと名前で再送は200。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postmanゲスト\",\n  \"client_request_id\": \"{{client_request_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "25. Calculate League Match",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/leagues/{{league_id}}/matches/calculate",
        "description": "所属リーグの利用可能ルールと4人を指定。200。点数をDBへ保存せず正確なpointを返す。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rule_id\": \"{{rule_id}}\",\n  \"players\": [\n    {\n      \"user_id\": \"{{player_1_id}}\",\n      \"raw_score\": 33300\n    },\n    {\n      \"user_id\": \"{{player_2_id}}\",\n      \"raw_score\": 33300\n    },\n    {\n      \"user_id\": \"{{player_3_id}}\",\n      \"raw_score\": 33300\n    },\n    {\n      \"user_id\": \"{{player_4_id}}\",\n      \"raw_score\": 100\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "26. Save League Match",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/leagues/{{league_id}}/matches",
        "description": "代理記録可。201、同じ操作IDと内容で再送は200、内容違いは409。標準ルール用の素点例。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rule_id\": \"{{rule_id}}\",\n  \"players\": [\n    {\n      \"user_id\": \"{{player_1_id}}\",\n      \"raw_score\": 33300\n    },\n    {\n      \"user_id\": \"{{player_2_id}}\",\n      \"raw_score\": 33300\n    },\n    {\n      \"user_id\": \"{{player_3_id}}\",\n      \"raw_score\": 33300\n    },\n    {\n      \"user_id\": \"{{player_4_id}}\",\n      \"raw_score\": 100\n    }\n  ],\n  \"season_id\": null,\n  \"match_date\": \"2024-11-01T00:00:00+09:00\",\n  \"client_request_id\": \"{{client_request_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "27. League Match Detail",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/leagues/{{league_id}}/matches/{{match_id}}",
        "description": "200 Match。原user_id、canonical_user_id、rank、正確なpointを取得。別リーグの対局は404。"
      },
      "response": []
    },
    {
      "name": "28. Request Participant Link",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/leagues/{{league_id}}/participant-links",
        "description": "登録本人がゲストとの紐付けに同意して申請。初回201、同じ操作の再送200。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"guest_user_id\": \"{{guest_user_id}}\",\n  \"client_request_id\": \"{{client_request_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "29. List Participant Links",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/leagues/{{league_id}}/participant-links",
        "description": "200 participant_links。memberは自分の申請、owner/adminは対象リーグの全申請。"
      },
      "response": []
    },
    {
      "name": "30. Approve Participant Link",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/leagues/{{league_id}}/participant-links/{{link_id}}/approve",
        "description": "owner/adminのみ。本人の申請を自己承認可。同卓で同じ本人が重複するなら409。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"confirmation_note\": \"対局した本人であることを確認\",\n  \"version\": \"{{link_version}}\",\n  \"client_request_id\": \"{{client_request_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "31. Reject Participant Link",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/leagues/{{league_id}}/participant-links/{{link_id}}/reject",
        "description": "owner/adminのみ。却下の場合も確認内容と版が必須。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"confirmation_note\": \"対局した本人であることを確認\",\n  \"version\": \"{{link_version}}\",\n  \"client_request_id\": \"{{client_request_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  }
}
