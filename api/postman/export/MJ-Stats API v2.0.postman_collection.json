        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/leagues/{{league_id}}/matches",
        "description": "代理記録可。201、同じ操作IDと内容で再送は200、内容違いは409。標準ルール用の素点例。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rule_id\": \"{{rule_id}}\",\n  \"players\": [\n    {\n      \"user_id\": \"{{player_1_id}}\",\n      \"raw_score\": 33300\n    },\n    {\n      \"user_id\": \"{{player_2_id}}\",\n      \"raw_score\": 33300\n    },\n    {\n      \"user_id\": \"{{player_3_id}}\",\n      \"raw_score\": 33300\n    },\n    {\n      \"user_id\": \"{{player_4_id}}\",\n      \"raw_score\": 100\n    }\n  ],\n  \"season_id\": null,\n  \"match_date\": \"2024-11-01T00:00:00+09:00\",\n  \"client_request_id\": \"{{client_request_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
