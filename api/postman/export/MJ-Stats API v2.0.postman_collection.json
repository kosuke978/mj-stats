{
  "info": {
    "name": "MJ-Stats API v2.0",
    "description": "Phase 2.5 Step 1: ES256/Auth-session protection. Complete display name before match APIs. Legacy match body/point contract is retained. Dedicated local DB only for writes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/health",
        "auth": {
          "type": "noauth"
        }
      },
      "response": []
    },
    {
      "name": "1. Calculate Match Points",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"players\": [\n    {\"player_id\": \"user_1\", \"raw_score\": 35000},\n    {\"player_id\": \"user_2\", \"raw_score\": 28000},\n    {\"player_id\": \"user_3\", \"raw_score\": 22000},\n    {\"player_id\": \"user_4\", \"raw_score\": 15000}\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/matches/calculate"
      },
      "response": []
    },
    {
      "name": "2. Create Match",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rule_id\": \"99999999-9999-9999-9999-999999999999\",\n  \"season_id\": null,\n  \"results\": [\n    {\"player_id\":\"11111111-1111-1111-1111-111111111111\",\"raw_score\":35000,\"point\":45.0,\"rank\":1,\"is_yakuman\":false},\n    {\"player_id\":\"22222222-2222-2222-2222-222222222222\",\"raw_score\":28000,\"point\":8.0,\"rank\":2,\"is_yakuman\":false},\n    {\"player_id\":\"33333333-3333-3333-3333-333333333333\",\"raw_score\":22000,\"point\":-18.0,\"rank\":3,\"is_yakuman\":false},\n    {\"player_id\":\"44444444-4444-4444-4444-444444444444\",\"raw_score\":15000,\"point\":-35.0,\"rank\":4,\"is_yakuman\":false}\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/matches"
      },
      "response": []
    },
    {
      "name": "3. Get Matches",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/matches",
        "description": "対局履歴一覧を取得します。"
      },
      "response": []
    },
    {
      "name": "4. Get Me",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/users/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"me is authenticated\", () => pm.response.to.have.status(200));",
              "pm.test(\"persistent participant + profile state\", () => { const u=pm.response.json(); pm.expect(u.id).to.be.a(\"string\"); pm.expect(u).to.have.property(\"profile_completed_at\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Set My Display Name",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/api/users/me",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Postman Player\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "6. Missing Bearer (401)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/users/me",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"unauthenticated\", () => pm.response.to.have.status(401));",
              "pm.test(\"common error\", () => pm.expect(pm.response.json().error.code).to.eql(\"UNAUTHENTICATED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Invalid JWT (401)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/users/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "invalid.jwt.fixture",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"invalid JWT rejected\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  }
}
