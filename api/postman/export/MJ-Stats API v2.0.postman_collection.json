    {
      "name": "16. Create League",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/leagues",
        "description": "名前設定済み登録者が初期ownerとして作成。初回201、同じ操作IDと内容の再送は200、内容違いは409。新規操作ごとにUUIDを変え、再送では同じUUIDを保持する。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postmanリーグ\",\n  \"client_request_id\": \"{{client_request_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "17. Current Invite",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/leagues/{{league_id}}/invites/current",
        "description": "owner/admin向け。200。未発行・期限切れ・失効時はinviteがnull。"
      },
      "response": []
    },
    {
      "name": "18. Issue Invite",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/leagues/{{league_id}}/invites",
        "description": "owner/admin向け。初回201、同じ操作IDでの再送は200。発行すると以前の未失効招待は失効。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_request_id\": \"{{client_request_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
