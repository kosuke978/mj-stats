{
  "info": {
    "name": "MJ-Stats API v2.0",
    "description": "2-4: 設定済みBearerでリーグ作成と所属リーグの参照。旧対局計算・保存は停止中。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/health",
        "auth": {
          "type": "noauth"
        }
      },
      "response": []
    },
    {
      "name": "1. Calculate Match Points (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/matches/calculate",
        "description": "名前設定済みは409 RECORDING_UNAVAILABLE。未認証は401。計算・保存の副作用なし。"
      },
      "response": []
    },
    {
      "name": "2. Create Match (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/matches",
        "description": "名前設定済みは409 RECORDING_UNAVAILABLE。未認証は401。計算・保存の副作用なし。"
      },
      "response": []
    },
    {
      "name": "3. Get Matches",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/leagues/{{league_id}}/matches?season=all&limit=20",
        "description": "所属リーグの通常対局だけ。season: all/unassigned/UUID、status: all/valid/cancelled、limit: 1〜100、cursor: 同じ条件のnext_cursor。"
      },
      "response": []
    },
    {
      "name": "4. Get Me",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/users/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"me is authenticated\", () => pm.response.to.have.status(200));",
              "pm.test(\"persistent participant + profile state\", () => { const u=pm.response.json(); pm.expect(u.id).to.be.a(\"string\"); pm.expect(u).to.have.property(\"profile_completed_at\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Set My Display Name",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/api/users/me",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Postman Player\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "6. Missing Bearer (401)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/users/me",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"unauthenticated\", () => pm.response.to.have.status(401));",
              "pm.test(\"common error\", () => pm.expect(pm.response.json().error.code).to.eql(\"UNAUTHENTICATED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Invalid JWT (401)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/users/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "invalid.jwt.fixture",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"invalid JWT rejected\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. My Leagues",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/leagues",
        "description": "本人の有効所属一覧。"
      },
      "response": []
    },
    {
      "name": "9. League",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/leagues/{{league_id}}",
        "description": "対象リーグと本人のrole。非所属または存在しないUUIDは403。"
      },
      "response": []
    },
    {
      "name": "10. Participants",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/leagues/{{league_id}}/participants?limit=20",
        "description": "有効な参加者。limit・cursor可。"
      },
      "response": []
    },
    {
      "name": "11. Members",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/leagues/{{league_id}}/members?limit=20",
        "description": "legacyを除く所属。limit・cursor可。"
      },
      "response": []
    },
    {
      "name": "12. Rules",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/leagues/{{league_id}}/rules?available=true&limit=20",
        "description": "available=true（既定）/false/all。limit・cursor可。"
      },
      "response": []
    },
    {
      "name": "13. Seasons",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/leagues/{{league_id}}/seasons?limit=20",
        "description": "UUID、開始・終了日はYYYY-MM-DDかNULL。limit・cursor可。"
      },
      "response": []
    },
    {
      "name": "14. History Without League (400)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/matches",
        "description": "旧全件経路の拒否。名前設定済みは400 INVALID_INPUT。"
      },
      "response": []
    },
    {
      "name": "15. Scoped History Adapter",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/matches?league_id={{league_id}}&season=all&limit=20",
        "description": "所属リーグの通常対局だけ。season: all/unassigned/UUID、status: all/valid/cancelled、limit: 1〜100、cursor: 同じ条件のnext_cursor。"
      },
      "response": []
    },
    {
      "name": "16. Create League",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/leagues",
        "description": "名前設定済み登録者が初期ownerとして作成。初回201、同じ操作IDと内容の再送は200、内容違いは409。新規操作ごとにUUIDを変え、再送では同じUUIDを保持する。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postmanリーグ\",\n  \"client_request_id\": \"{{client_request_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  }
}
