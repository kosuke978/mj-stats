{
  "info": {
    "name": "MJ-Stats API",
    "description": "2-3: 設定済みBearerで所属リーグの参照。旧計算・保存は停止中。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "3a515ecb-86f1-49f5-8ef8-e9742e2c77b5"
  },
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/health",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "1. Calculate Match Points (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/matches/calculate",
        "description": "名前設定済みは409 RECORDING_UNAVAILABLE。未認証は401。計算・保存の副作用なし。"
      }
    },
    {
      "name": "2. Create Match (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/matches",
        "description": "名前設定済みは409 RECORDING_UNAVAILABLE。未認証は401。計算・保存の副作用なし。"
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  }
}
